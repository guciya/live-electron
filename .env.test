# NikoLive 测试环境配置（npm run build:test / pack:test 时生效，优先级高于 .env）

# 用户认证接口域名（手机号验证码登录 / 发送短信验证码）
VUE_APP_API_AUTH_URL=https://test-api.nikolive.cn

# 直播业务接口域名（开播/关播/观众列表/礼物）
VUE_APP_API_BASE_URL=https://test-live.nikolive.cn

# 图片资源域名（头像、封面）
VUE_APP_IMAGE_DOMAIN=https://test-image.nikolive.cn

# CMS 主播监控列表域名（liveMonitorList / liveFocusMonitorList）
VUE_APP_CMS_BASE_URL=https://test-cms.nikolive.cn

# H5 业务页域名（家族入驻/公会入驻等软件内部跳转页面）
VUE_APP_H5_WEB_BASE=https://h5.nikolive.cn

# 腾讯云 TRTC SDKAppID，必须与登录接口下发 sign 所属应用一致
VUE_APP_TRTC_SDK_APPID=1600084758
