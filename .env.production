# NikoLive 正式环境配置（npm run build:prod / pack:prod 时生效，优先级高于 .env）

# 用户认证接口域名（手机号验证码登录 / 发送短信验证码）
VUE_APP_API_AUTH_URL=https://api.nikolive.cn

# 直播业务接口域名（开播/关播/观众列表/礼物）
VUE_APP_API_BASE_URL=https://live.nikolive.cn

# 图片资源域名（头像、封面）
VUE_APP_IMAGE_DOMAIN=https://image.nikolive.cn

# CMS 主播监控列表域名（liveMonitorList / liveFocusMonitorList）
VUE_APP_CMS_BASE_URL=https://cms.nikolive.cn

# CMS 主播监控列表鉴权 token（正式环境）
VUE_APP_CMS_AUTH_TOKEN=ZXlKMGVYQWlPaUpLVjFRaUxDSmhiR2NpT2lKSVV6STFOaUo5LmV5SnBZWFFpT2pFM09USTVPREE1TVRJc0ltVjRjQ0k2TVRjNU16VTROVGN4TWl3aWJXRnVZV2RsY2w5cFpDSTZOSDAuWm4wX2NtSWg2QWk5WGJsajlFREN1bDNPeFdxOGRDOUlsencyNWdDR0J4cw==

# H5 业务页域名（家族入驻/公会入驻等软件内部跳转页面）
VUE_APP_H5_WEB_BASE=https://h5.nikolive.cn

# 腾讯云 TRTC SDKAppID（正式环境应用，与 web-obs-live 正式环境一致）
VUE_APP_TRTC_SDK_APPID=1600108837
