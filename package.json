{
  "name": "ultra-live-electron",
  "version": "6.5.0",
  "description": "Tencent Cloud Living and Streaming Tool for desktop and laptop",
  "main": "main.js",
  "author": "Tencent Cloud",
  "license": "MIT",
  "build": {
    "appId": "com.niko.live",
    "productName": "Niko直播伴侣",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "!dist/win-unpacked/**",
      "!dist-dev/**",
      "!release/**",
      "!release-test/**",
      "!release-test3/**",
      "!release-test4/**"
    ],
    "extraResources": [
      {
        "from": "node_modules/trtc-electron-sdk/build/Release",
        "to": "."
      },
      {
        "from": "build",
        "to": "build",
        "filter": [
          "icon.ico",
          "icon.png",
          "icon-round-*.png"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.social-networking",
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "icon": "build/icon.png"
    }
  },
  "scripts": {
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build",
    "lint": "vue-cli-service lint",
    "prestart": "node scripts/prestart.js",
    "start": "electron . --dist",
    "start:serve": "concurrently \"npm run serve\" \"npm run electron\"",
    "preelectron": "node scripts/postinstall.js",
    "electron": "electron .",
    "build:dev": "vue-cli-service build --mode development --dest dist-dev",
    "start:fast": "electron . --dist",
    "build:test": "vue-cli-service build --mode test --dest dist --no-clean",
    "build:prod": "vue-cli-service build --mode production --dest dist --no-clean",
    "build:win64": "electron-builder --win --x64",
    "pack:win64": "npm run build && npm run build:win64",
    "pack:test": "npm run build:test && electron-builder --win --x64 -c.directories.output=release-test -c.productName=Niko直播伴侣-test -c.artifactName=NikoLive-test-Setup-${version}.${ext}",
    "pack:prod": "npm run build:prod && electron-builder --win --x64 -c.directories.output=release -c.productName=Niko直播伴侣 -c.artifactName=NikoLive-Setup-${version}.${ext}",
    "build:mac-x64": "electron-builder --mac --x64",
    "build:mac-arm64": "electron-builder --mac --arm64",
    "build:mac-universal": "electron-builder --mac --universal",
    "pack:mac-x64": "node scripts/build-mac-dmg.js x64",
    "pack:mac-arm64": "node scripts/build-mac-dmg.js arm64",
    "pack:mac": "node scripts/build-mac-dmg.js both",
    "upload-server": "npm --prefix ./upload-server run start",
    "upload-server:standalone": "npm --prefix ./upload-server run start",
    "upload-server:bootstrap": "npm --prefix ./upload-server install",
    "start:with-upload-server": "concurrently \"npm run serve\" \"npm run upload-server\" \"npm run electron\""
  },
  "dependencies": {
    "@tencentcloud/tuiroom-engine-electron": "~4.2.1",
    "@tencentcloud/uikit-base-component-vue3": "1.4.8",
    "core-js": "^3.36.1",
    "flv.js": "^1.6.2",
    "pinia": "^2.1.7",
    "svgaplayerweb": "^2.3.2",
    "three": "^0.160.0",
    "trtc-electron-plugin-xmagic": "2.0.0-beta.0",
    "trtc-electron-sdk": "13.4.802-beta.1",
    "tuikit-atomicx-vue3-electron": "6.5.0",
    "video-animation-player": "^1.0.5",
    "vue": "^3.4.0",
    "vue-router": "^4.3.1"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vue/cli-plugin-babel": "~5.0.8",
    "@vue/cli-plugin-eslint": "~5.0.8",
    "@vue/cli-plugin-router": "~5.0.8",
    "@vue/cli-plugin-typescript": "~5.0.8",
    "@vue/cli-plugin-vuex": "~5.0.8",
    "@vue/cli-service": "~5.0.8",
    "@vue/eslint-config-typescript": "^9.1.0",
    "axios": "^1.6.8",
    "concurrently": "^8.2.2",
    "electron": "^19.1.9",
    "electron-builder": "^24.13.3",
    "electron-devtools-installer": "^3.2.0",
    "eslint": "^7.32.0",
    "eslint-plugin-vue": "^8.7.1",
    "extract-zip": "^2.0.1",
    "jose": "^1.28.2",
    "native-ext-loader": "^2.3.0",
    "replace": "^1.2.1",
    "request": "^2.88.2",
    "sass": "^1.72.0",
    "sass-loader": "^12.6.0"
  },
  "overrides": {
    "@tencentcloud/tuiroom-engine-electron": {
      "trtc-electron-sdk": "$trtc-electron-sdk"
    }
  }
}
